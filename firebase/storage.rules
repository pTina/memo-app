rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/fonts/{fontId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('font/.*|application/font-.*|application/octet-stream|application/x-font-ttf|application/x-font-otf');
    }
  }
}
